rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: Deploy these rules with `firebase deploy --only firestore:rules`
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User challenges subcollection
      match /challenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      // User achievements subcollection
      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }

      // User quota subcollection (AI message limits)
      match /quota/{date} {
        allow read, write: if isOwner(userId);
      }

      // User courses subcollection (Progress tracking)
      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // User interview sessions
      match /interview_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Challenges collection (read-only for clients, write allowed for seeding)
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Enabled for seeding
    }

    // Courses collection (read-only for clients, write allowed for seeding)
    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Enabled for seeding
    }

    // Achievements master collection (write allowed for seeding)
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Skill Modules collection (write allowed for seeding)
    match /skill_modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Waitlist collection
    match /waitlist/{entryId} {
      allow create: if true;
      allow read, update, delete: if isOwner(entryId);
    }
  }
}
