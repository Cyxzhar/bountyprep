rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // IMPORTANT: Deploy these rules with `firebase deploy --only firestore:rules`
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User challenges subcollection
      match /challenges/{challengeId} {
        allow read, write: if isOwner(userId);
      }

      // User achievements subcollection
      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }

      // User quota subcollection (AI message limits)
      match /quota/{date} {
        allow read, write: if isOwner(userId);
      }

      // User courses subcollection (Progress tracking)
      match /courses/{courseId} {
        allow read, write: if isOwner(userId);
      }

      // User interview sessions (new format)
      match /interview_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // User interview data (old format - for migration)
      match /interview/{document} {
        allow read, write: if isOwner(userId);
      }
    }

    // Challenges collection (LOCKED: read-only, writes via Admin SDK only)
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if false;
    }

    // Courses collection (LOCKED: read-only, writes via Admin SDK only)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if false;
    }

    // Achievements master collection (LOCKED: read-only, writes via Admin SDK only)
    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if false;
    }

    // Skill Modules collection (LOCKED: read-only, writes via Admin SDK only)
    match /skill_modules/{moduleId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Waitlist collection (validated creates only)
    match /waitlist/{entryId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.email.size() < 255;
      allow read, update, delete: if isOwner(entryId);
    }
  }
}
